{
  "schemaVersion": 10,
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5"
  },
  "type": "default",
  "id": "pickup-inspection-form",
  "components": [
    {
      "key": "formValidationErrors",
      "label": "Validation errors",
      "type": "textfield",
      "disabled": true
    },
    {
      "key": "pickupAccepted",
      "label": "Customer accepts the order",
      "type": "checkbox"
    },
    {
      "key": "pickupAcceptedError",
      "label": "Customer acceptance error",
      "type": "textfield",
      "disabled": true
    },
    {
      "key": "pickupComment",
      "label": "Pickup comment or rejection reason",
      "type": "textarea",
      "validate": {
        "maxLength": 500
      }
    },
    {
      "key": "pickupCommentError",
      "label": "Comment error",
      "type": "textfield",
      "disabled": true
    }
  ]
}
