<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MarkDelivered" targetNamespace="http://blss.com/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:process id="markDeliveredProcess" name="Mark Delivered Process" isExecutable="true" camunda:candidateStarterGroups="WAREHOUSE,ADMIN" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="Start_MarkDelivered" name="Mark order item delivered" camunda:formRef="mark-delivered-form" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateDelivery" name="Validate delivery mark" camunda:asyncBefore="true" camunda:type="external" camunda:topic="mark-delivered: validate">
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_DeliveryValidationError" attachedToRef="Task_ValidateDelivery">
      <bpmn:outgoing>Flow_DeliveryError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_InvalidDeliveryMark" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_UpdateYacheyka" name="Save storage cell" camunda:asyncBefore="true" camunda:type="external" camunda:topic="mark-delivered: update-yacheyka">
      <bpmn:incoming>Flow_Validate_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_CheckReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckReady" name="Check all items delivered" camunda:asyncBefore="true" camunda:type="external" camunda:topic="mark-delivered: check-ready">
      <bpmn:incoming>Flow_Update_CheckReady</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckReady_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OrderReady" name="All items delivered?">
      <bpmn:incoming>Flow_CheckReady_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_SetStatus</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotReady_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SetReady" name="Set order ready for pickup" camunda:asyncBefore="true" camunda:type="external" camunda:topic="mark-delivered: set-ready">
      <bpmn:incoming>Flow_Ready_SetStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_SetReady_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_MarkedDelivered" name="Delivery mark processed">
      <bpmn:incoming>Flow_NotReady_End</bpmn:incoming>
      <bpmn:incoming>Flow_SetReady_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_DeliveryRejected" name="Delivery mark rejected">
      <bpmn:incoming>Flow_DeliveryError_End</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_InvalidDeliveryMark" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="Start_MarkDelivered" targetRef="Task_ValidateDelivery" />
    <bpmn:sequenceFlow id="Flow_Validate_Update" sourceRef="Task_ValidateDelivery" targetRef="Task_UpdateYacheyka" />
    <bpmn:sequenceFlow id="Flow_Update_CheckReady" sourceRef="Task_UpdateYacheyka" targetRef="Task_CheckReady" />
    <bpmn:sequenceFlow id="Flow_CheckReady_Gateway" sourceRef="Task_CheckReady" targetRef="Gateway_OrderReady" />
    <bpmn:sequenceFlow id="Flow_Ready_SetStatus" name="Yes" sourceRef="Gateway_OrderReady" targetRef="Task_SetReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderReady == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotReady_End" name="No" sourceRef="Gateway_OrderReady" targetRef="End_MarkedDelivered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderReady != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SetReady_End" sourceRef="Task_SetReady" targetRef="End_MarkedDelivered" />
    <bpmn:sequenceFlow id="Flow_DeliveryError_End" sourceRef="Boundary_DeliveryValidationError" targetRef="End_DeliveryRejected" />
  </bpmn:process>
  <bpmn:error id="Error_InvalidDeliveryMark" name="InvalidDeliveryMark" errorCode="INVALID_DELIVERY_MARK" />
  <bpmndi:BPMNDiagram id="Diagram_MarkDelivered">
    <bpmndi:BPMNPlane id="Plane_MarkDelivered" bpmnElement="markDeliveredProcess">
      <bpmndi:BPMNShape id="Start_MarkDelivered_di" bpmnElement="Start_MarkDelivered">
        <dc:Bounds x="180" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="159" y="206" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateDelivery_di" bpmnElement="Task_ValidateDelivery">
        <dc:Bounds x="280" y="148" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateYacheyka_di" bpmnElement="Task_UpdateYacheyka">
        <dc:Bounds x="500" y="148" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckReady_di" bpmnElement="Task_CheckReady">
        <dc:Bounds x="720" y="148" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderReady_di" bpmnElement="Gateway_OrderReady" isMarkerVisible="true">
        <dc:Bounds x="930" y="163" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="213" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetReady_di" bpmnElement="Task_SetReady">
        <dc:Bounds x="1060" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_MarkedDelivered_di" bpmnElement="End_MarkedDelivered">
        <dc:Bounds x="1280" y="170" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1264" y="206" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_DeliveryRejected_di" bpmnElement="End_DeliveryRejected">
        <dc:Bounds x="500" y="330" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="484" y="366" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DeliveryValidationError_di" bpmnElement="Boundary_DeliveryValidationError">
        <dc:Bounds x="342" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Validate_di" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="216" y="188" />
        <di:waypoint x="280" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Update_di" bpmnElement="Flow_Validate_Update">
        <di:waypoint x="430" y="188" />
        <di:waypoint x="500" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Update_CheckReady_di" bpmnElement="Flow_Update_CheckReady">
        <di:waypoint x="650" y="188" />
        <di:waypoint x="720" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckReady_Gateway_di" bpmnElement="Flow_CheckReady_Gateway">
        <di:waypoint x="870" y="188" />
        <di:waypoint x="930" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ready_SetStatus_di" bpmnElement="Flow_Ready_SetStatus">
        <di:waypoint x="955" y="163" />
        <di:waypoint x="955" y="130" />
        <di:waypoint x="1060" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="961" y="137" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotReady_End_di" bpmnElement="Flow_NotReady_End">
        <di:waypoint x="980" y="188" />
        <di:waypoint x="1280" y="188" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1127" y="173" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SetReady_End_di" bpmnElement="Flow_SetReady_End">
        <di:waypoint x="1210" y="130" />
        <di:waypoint x="1298" y="130" />
        <di:waypoint x="1298" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeliveryError_End_di" bpmnElement="Flow_DeliveryError_End">
        <di:waypoint x="360" y="246" />
        <di:waypoint x="360" y="348" />
        <di:waypoint x="500" y="348" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
