<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_UpdateProduct"
                  targetNamespace="http://blss.com/bpmn">
  <bpmn:process id="updateProductProcess" name="Update Product Process" isExecutable="true"
                camunda:candidateStarterGroups="MANAGER,ADMIN"
                camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="Start_UpdateProduct" name="Update product"
                     camunda:formRef="product-update-form" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_Start_Update</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_UpdateProduct" name="Validate and update product"
                      camunda:type="external" camunda:topic="update-product: update">
      <bpmn:incoming>Flow_Start_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_UpdateProductError" attachedToRef="Task_UpdateProduct">
      <bpmn:outgoing>Flow_UpdateError_End</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_InvalidProductUpdate"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_ProductUpdated" name="Product updated">
      <bpmn:incoming>Flow_Update_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ProductUpdateRejected" name="Product update rejected">
      <bpmn:incoming>Flow_UpdateError_End</bpmn:incoming>
      <bpmn:errorEventDefinition errorRef="Error_InvalidProductUpdate"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Update" sourceRef="Start_UpdateProduct" targetRef="Task_UpdateProduct"/>
    <bpmn:sequenceFlow id="Flow_Update_End" sourceRef="Task_UpdateProduct" targetRef="End_ProductUpdated"/>
    <bpmn:sequenceFlow id="Flow_UpdateError_End" sourceRef="Boundary_UpdateProductError" targetRef="End_ProductUpdateRejected"/>
  </bpmn:process>
  <bpmn:error id="Error_InvalidProductUpdate" name="InvalidProductUpdate" errorCode="INVALID_PRODUCT_UPDATE"/>
  <bpmndi:BPMNDiagram id="Diagram_UpdateProduct">
    <bpmndi:BPMNPlane id="Plane_UpdateProduct" bpmnElement="updateProductProcess">
      <bpmndi:BPMNShape id="Start_UpdateProduct_di" bpmnElement="Start_UpdateProduct">
        <dc:Bounds x="120" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateProduct_di" bpmnElement="Task_UpdateProduct">
        <dc:Bounds x="230" y="98" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_UpdateProductError_di" bpmnElement="Boundary_UpdateProductError">
        <dc:Bounds x="302" y="160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ProductUpdated_di" bpmnElement="End_ProductUpdated">
        <dc:Bounds x="480" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ProductUpdateRejected_di" bpmnElement="End_ProductUpdateRejected">
        <dc:Bounds x="480" y="240" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Update_di" bpmnElement="Flow_Start_Update">
        <di:waypoint x="156" y="138"/>
        <di:waypoint x="230" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Update_End_di" bpmnElement="Flow_Update_End">
        <di:waypoint x="410" y="138"/>
        <di:waypoint x="480" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateError_End_di" bpmnElement="Flow_UpdateError_End">
        <di:waypoint x="320" y="196"/>
        <di:waypoint x="320" y="258"/>
        <di:waypoint x="480" y="258"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
