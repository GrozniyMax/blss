<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_CreateProduct"
                  targetNamespace="http://blss.com/bpmn">

    <bpmn:process id="createProductProcess" name="Create Product Process" isExecutable="true"
                  camunda:candidateStarterGroups="MANAGER,ADMIN"
                  camunda:historyTimeToLive="P30D">

        <bpmn:startEvent id="StartEvent_Create" name="Create product">
            <bpmn:extensionElements>
                <camunda:formData>
                    <camunda:formField id="productName" label="Product name" type="string">
                        <camunda:validation>
                            <camunda:constraint name="required"/>
                            <camunda:constraint name="maxlength" config="100"/>
                        </camunda:validation>
                    </camunda:formField>

                    <camunda:formField id="initialCount" label="Initial quantity" type="long" defaultValue="1">
                        <camunda:validation>
                            <camunda:constraint name="required"/>
                            <camunda:constraint name="min" config="1"/>
                            <camunda:constraint name="max" config="10000000"/>
                        </camunda:validation>
                    </camunda:formField>

                    <camunda:formField id="price" label="Price" type="string" defaultValue="0"/>

                    <camunda:formField id="productData" label="Additional data (JSON)" type="string" defaultValue="{}"/>
                </camunda:formData>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_Start_to_Validate</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:serviceTask id="Task_ValidateAndCheck"
                          name="Validate and check existence"
                          camunda:type="external"
                          camunda:topic="create-product: validate" camunda:asyncBefore="true">            <bpmn:incoming>Flow_Start_to_Validate</bpmn:incoming>
            <bpmn:outgoing>Flow_Validate_to_Gateway</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:boundaryEvent id="Error_Validation" attachedToRef="Task_ValidateAndCheck">
            <bpmn:outgoing>Flow_Error_Validation</bpmn:outgoing>
            <bpmn:errorEventDefinition errorRef="Error_InvalidInput"/>
        </bpmn:boundaryEvent>

        <bpmn:exclusiveGateway id="Gateway_ProductExists" name="Already exists?">
            <bpmn:incoming>Flow_Validate_to_Gateway</bpmn:incoming>
            <bpmn:outgoing>Flow_Exists_Yes</bpmn:outgoing>
            <bpmn:outgoing>Flow_Exists_No</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:serviceTask id="Task_SaveProductAndStore"
                          name="Save product and inventory record"
                          camunda:type="external"
                          camunda:topic="create-product: store" camunda:asyncBefore="true">            <bpmn:incoming>Flow_Exists_No</bpmn:incoming>
            <bpmn:outgoing>Flow_Save_to_End</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_Success" name="Product created">
            <bpmn:incoming>Flow_Save_to_End</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:endEvent id="EndEvent_AlreadyExists" name="Already exists">
            <bpmn:incoming>Flow_Exists_Yes</bpmn:incoming>
            <bpmn:errorEventDefinition errorRef="Error_AlreadyExists"/>
        </bpmn:endEvent>

        <bpmn:endEvent id="EndEvent_InvalidInput" name="Invalid input">
            <bpmn:incoming>Flow_Error_Validation</bpmn:incoming>
            <bpmn:errorEventDefinition errorRef="Error_InvalidInput"/>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_Start_to_Validate"
                           sourceRef="StartEvent_Create"
                           targetRef="Task_ValidateAndCheck"/>

        <bpmn:sequenceFlow id="Flow_Validate_to_Gateway"
                           sourceRef="Task_ValidateAndCheck"
                           targetRef="Gateway_ProductExists"/>

        <bpmn:sequenceFlow id="Flow_Exists_Yes"
                           sourceRef="Gateway_ProductExists"
                           targetRef="EndEvent_AlreadyExists">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${productExists == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="Flow_Exists_No"
                           sourceRef="Gateway_ProductExists"
                           targetRef="Task_SaveProductAndStore">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${productExists == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>

        <bpmn:sequenceFlow id="Flow_Save_to_End"
                           sourceRef="Task_SaveProductAndStore"
                           targetRef="EndEvent_Success"/>

        <bpmn:sequenceFlow id="Flow_Error_Validation"
                           sourceRef="Error_Validation"
                           targetRef="EndEvent_InvalidInput"/>
    </bpmn:process>

    <bpmn:error id="Error_InvalidInput"
                name="InvalidInput"
                errorCode="VALIDATION_FAILED"/>
    <bpmn:error id="Error_AlreadyExists"
                name="ProductAlreadyExists"
                errorCode="PRODUCT_ALREADY_EXISTS"/>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="createProductProcess">

            <bpmndi:BPMNShape id="StartEvent_Create_di" bpmnElement="StartEvent_Create">
                <dc:Bounds x="152" y="200" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="138" y="243" width="64" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Task_ValidateAndCheck_di" bpmnElement="Task_ValidateAndCheck">
                <dc:Bounds x="240" y="178" width="140" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Error_Validation_di" bpmnElement="Error_Validation">
                <dc:Bounds x="292" y="240" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Gateway_ProductExists_di" bpmnElement="Gateway_ProductExists" isMarkerVisible="true">
                <dc:Bounds x="435" y="193" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="420" y="163" width="80" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Task_SaveProductAndStore_di" bpmnElement="Task_SaveProductAndStore">
                <dc:Bounds x="540" y="178" width="160" height="80"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
                <dc:Bounds x="752" y="200" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="735" y="243" width="73" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="EndEvent_AlreadyExists_di" bpmnElement="EndEvent_AlreadyExists">
                <dc:Bounds x="442" y="80" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="420" y="55" width="80" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="EndEvent_InvalidInput_di" bpmnElement="EndEvent_InvalidInput">
                <dc:Bounds x="292" y="362" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="270" y="405" width="80" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <!-- ============ EDGES ============ -->
            <bpmndi:BPMNEdge id="Flow_Start_to_Validate_di" bpmnElement="Flow_Start_to_Validate">
                <di:waypoint x="188" y="218"/>
                <di:waypoint x="240" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Validate_to_Gateway_di" bpmnElement="Flow_Validate_to_Gateway">
                <di:waypoint x="380" y="218"/>
                <di:waypoint x="435" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Exists_Yes_di" bpmnElement="Flow_Exists_Yes">
                <di:waypoint x="460" y="193"/>
                <di:waypoint x="460" y="116"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Exists_No_di" bpmnElement="Flow_Exists_No">
                <di:waypoint x="485" y="218"/>
                <di:waypoint x="540" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Save_to_End_di" bpmnElement="Flow_Save_to_End">
                <di:waypoint x="700" y="218"/>
                <di:waypoint x="752" y="218"/>
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Flow_Error_Validation_di" bpmnElement="Flow_Error_Validation">
                <di:waypoint x="310" y="276"/>
                <di:waypoint x="310" y="362"/>
            </bpmndi:BPMNEdge>

        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>

