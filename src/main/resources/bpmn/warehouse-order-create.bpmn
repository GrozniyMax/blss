<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_WarehouseOrderCreate"
                  targetNamespace="http://blss.com/camunda/warehouse">
  <bpmn:process id="warehouse-order-create" name="Создание заказа" isExecutable="true"
                camunda:candidateStarterGroups="USER,ADMIN">
    <bpmn:startEvent id="Start_OrderCreate" name="Клиент оформляет заказ"
                     camunda:formRef="order-create-form" camunda:formRefBinding="latest">
      <bpmn:outgoing>Flow_OrderCreate_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CreateOrder" name="Проверить данные, забронировать товар и создать заказ"
                      camunda:type="external" camunda:topic="order.create">
      <bpmn:incoming>Flow_OrderCreate_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderCreate_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_OrderCreated" name="Заказ создан">
      <bpmn:incoming>Flow_OrderCreate_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_OrderCreate_Start" sourceRef="Start_OrderCreate" targetRef="Task_CreateOrder"/>
    <bpmn:sequenceFlow id="Flow_OrderCreate_End" sourceRef="Task_CreateOrder" targetRef="End_OrderCreated"/>
  </bpmn:process>
</bpmn:definitions>
