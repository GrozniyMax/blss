      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health is 200', function () { pm.response.to.have.status(200); });",
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('e2eUsername', 'e2e_user_' + runId);"
            ]
