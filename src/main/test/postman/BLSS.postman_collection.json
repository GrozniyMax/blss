{
  "info": {
    "name": "BLSS WildFly JTA Smoke",
    "_postman_id": "c73f6833-4ebc-4308-8958-9eaa18df1a01",
    "description": "Smoke and transaction checks for BLSS deployed on WildFly profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{authUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{authPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/blss"
    },
    {
      "key": "authUser",
      "value": "CHANGE_ME_FROM_USERS_XML"
    },
    {
      "key": "authPassword",
      "value": "CHANGE_ME_FROM_USERS_XML"
    },
    {
      "key": "owner",
      "value": "CHANGE_ME_FROM_USERS_XML"
    },
    {
      "key": "invalidProductId",
      "value": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('owner') || pm.collectionVariables.get('owner') === 'CHANGE_ME_FROM_USERS_XML') {",
          "  pm.collectionVariables.set('owner', pm.collectionVariables.get('authUser'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create Delivery Point",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.collectionVariables.set('dpName', `PVZ-${suffix}`);",
              "pm.collectionVariables.set('dpAddress', `Address-${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delivery point created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('locationId', body.data.id);",
              "pm.test('locationId captured', function () { pm.expect(pm.collectionVariables.get('locationId')).to.be.ok; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{dpName}}\",\n  \"address\": \"{{dpAddress}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/delivery-points",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "delivery-points"
          ]
        }
      }
    },
    {
      "name": "2. Create Product 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('product1Name', `Laptop-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product 1 created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('productId1', body.data.product.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{product1Name}}\",\n  \"price\": 999.99,\n  \"initialCount\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products"
          ]
        }
      }
    },
    {
      "name": "3. Create Product 2",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('product2Name', `Phone-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Product 2 created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('productId2', body.data.product.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{product2Name}}\",\n  \"price\": 499.99,\n  \"initialCount\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products"
          ]
        }
      }
    },
    {
      "name": "4. Count Before Success Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Count fetched', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('countBefore', Number(body.data));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId1}}/count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId1}}",
            "count"
          ]
        }
      }
    },
    {
      "name": "5. Create Valid Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('orderId', body.data.orderId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner\": \"{{owner}}\",\n  \"location\": \"{{locationId}}\",\n  \"productIds\": [\n    \"{{productId1}}\",\n    \"{{productId2}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/order/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "create"
          ]
        }
      }
    },
    {
      "name": "6. Get Order And Capture Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order fetched', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.expect(body.data.positions.length).to.be.above(0);",
              "pm.collectionVariables.set('orderItemId', body.data.positions[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/order/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "7. Count After Success Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Count fetched', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('countAfterSuccess', Number(body.data));",
              "const before = Number(pm.collectionVariables.get('countBefore'));",
              "pm.test('Stock decremented by 1', function () { pm.expect(Number(body.data)).to.eql(before - 1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId1}}/count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId1}}",
            "count"
          ]
        }
      }
    },
    {
      "name": "8. Count Before Invalid Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Count fetched', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('countBeforeInvalid', Number(body.data));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId1}}/count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId1}}",
            "count"
          ]
        }
      }
    },
    {
      "name": "9. Create Invalid Order (Rollback Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid order rejected', function () { pm.expect(pm.response.code).to.be.oneOf([400, 404, 422]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner\": \"{{owner}}\",\n  \"location\": \"{{locationId}}\",\n  \"productIds\": [\n    \"{{productId1}}\",\n    \"{{invalidProductId}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/order/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "create"
          ]
        }
      }
    },
    {
      "name": "10. Count After Invalid Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Count fetched', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const before = Number(pm.collectionVariables.get('countBeforeInvalid'));",
              "pm.test('Stock unchanged after failed order', function () { pm.expect(Number(body.data)).to.eql(before); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/inventory/products/{{productId1}}/count",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inventory",
            "products",
            "{{productId1}}",
            "count"
          ]
        }
      }
    },
    {
      "name": "11. Status Next (to PROCESSING)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status changed', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/order/{{orderId}}/status/next",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "{{orderId}}",
            "status",
            "next"
          ]
        }
      }
    },
    {
      "name": "12. Status Next (to IN_DELIVERY)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status changed', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/order/{{orderId}}/status/next",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "{{orderId}}",
            "status",
            "next"
          ]
        }
      }
    },
    {
      "name": "13. Mark Delivered",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Item marked delivered', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": \"{{orderItemId}}\",\n  \"yacheyka\": \"A-12-2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/mark-delivered",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mark-delivered"
          ]
        }
      }
    }
  ]
}
