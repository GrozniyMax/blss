### BLSS E2E Test Collection
### IntelliJ IDEA HTTP Client format
### Replace Postman collection for end-to-end testing
### Services: user-service(25104), order-service(25103), status-service(25105)

# @name health_check
GET {{orderServiceUrl}}/actuator/health
Content-Type: application/json

> {%
    const runId = Date.now().toString();
    client.global.set("runId", runId);
    client.global.set("e2eUsername", "e2e_user_" + runId);
    client.test("health is 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });
%}

###

# @name users_create
POST {{userServiceUrl}}/users
Authorization: Basic {{adminUsername}}:{{adminPassword}}
Content-Type: application/json

{
  "username": "{{e2eUsername}}",
  "password": "e2e_pass_123",
  "roles": ["USER"]
}

> {%
    client.test("user created", function() {
        client.assert(response.status === 201, "Expected status 201");
    });
%}

###

# @name users_list
GET {{userServiceUrl}}/users
Authorization: Basic {{adminUsername}}:{{adminPassword}}

> {%
    client.test("users listed", function() {
        client.assert(response.status === 200, "Expected status 200");
    });
%}

