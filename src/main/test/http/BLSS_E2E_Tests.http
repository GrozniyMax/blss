# @name order_create_1
POST {{orderServiceUrl}}/order/create
Authorization: Basic {{managerUsername}}:{{managerPassword}}
Content-Type: application/json

{
  "owner": "admin",
  "location": "{{deliveryPointId}}",
  "productIds": ["{{productId1}}"]
}

> {%
    client.test("order 1 created", function() {
        client.assert(response.status === 201, "Expected status 201");
        const body = response.body;
        if (body && body.data && body.data.orderId) {
            client.global.set("orderId1", body.data.orderId);
        }
    });
%}

###

# @name order_get_1
GET {{orderServiceUrl}}/order/{{orderId1}}
Authorization: Basic {{consultantUsername}}:{{consultantPassword}}

> {%
    client.test("order 1 fetched", function() {
        client.assert(response.status === 200, "Expected status 200");
        const body = response.body;
        if (body && body.data && body.data.positions && body.data.positions.length > 0) {
            client.global.set("orderItemId1", body.data.positions[0].id);
        }
    });
%}

###

