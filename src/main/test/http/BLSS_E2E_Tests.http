# @name delivery_points_create
POST {{orderServiceUrl}}/delivery-points
Authorization: Basic {{managerUsername}}:{{managerPassword}}
Content-Type: application/json

{
  "name": "PVZ-{{runId}}",
  "address": "Address-{{runId}}"
}

> {%
    client.test("delivery point created", function() {
        client.assert(response.status === 201, "Expected status 201");
        const body = response.body;
        if (body && body.data && body.data.id) {
            client.global.set("deliveryPointId", body.data.id);
        }
    });
%}

