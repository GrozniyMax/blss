# @name users_update
PATCH {{userServiceUrl}}/users/{{e2eUsername}}
Authorization: Basic {{adminUsername}}:{{adminPassword}}
Content-Type: application/json

{
  "password": "e2e_pass_123",
  "roles": ["USER"],
