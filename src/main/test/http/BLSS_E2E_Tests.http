# @name inventory_create_product_1
POST {{orderServiceUrl}}/inventory/products
Authorization: Basic {{managerUsername}}:{{managerPassword}}
Content-Type: application/json

{
  "name": "Product-A-{{runId}}",
  "price": 100.50,
  "initialCount": 10
}

> {%
    client.test("product 1 created", function() {
        client.assert(response.status === 201, "Expected status 201");
        const body = response.body;
        if (body && body.data && body.data.product && body.data.product.id) {
            client.global.set("productId1", body.data.product.id);
        }
    });
%}

