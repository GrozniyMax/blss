<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_Lab3"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <message id="Message_OrderCreated" name="Команда на создание заказа" />
  <message id="Message_StatusChanged" name="Событие OrderStatusChanged" />
  <message id="Message_EisSync" name="Документ заказа для EIS" />

  <collaboration id="Collaboration_Lab3">
    <participant id="Participant_Client" name="Клиент" processRef="Process_Client" />
    <participant id="Participant_OrderService" name="Order Service" processRef="Process_OrderService" />
    <participant id="Participant_ActiveMQ" name="ActiveMQ Queue" processRef="Process_ActiveMQ" />
    <participant id="Participant_Node1" name="Узел обработки #1 (status-service)" processRef="Process_Node1" />
    <participant id="Participant_Node2" name="Узел обработки #2 (user-service/notification node)" processRef="Process_Node2" />
    <participant id="Participant_Quartz" name="Quartz Scheduler" processRef="Process_Quartz" />
    <participant id="Participant_EIS" name="Внешняя EIS через JCA" processRef="Process_EIS" />
    <participant id="Participant_0sp431r" name="Create product Transaction" processRef="Process_0nz3wm4" />
    <participant id="Participant_1pbxk6t" name="Update product count Transaction" processRef="Process_1fg9d4n" />
    <participant id="Participant_0yusntf" name="Book Transaction" processRef="Process_05x46yj" />
    <participant id="Participant_1wgmyqy" name="Update order status Transaction" processRef="Process_1298f1a" />
    <participant id="Participant_18732gp" name="Update product count Transaction" processRef="Process_1p4htho" />
    <participant id="Participant_0lgyktb" name="Order check Transaction" processRef="Process_05fu806" />
    <participant id="Participant_0cnfq75" name="Update yacheyka Transaction" processRef="Process_1alnsqx" />
    <participant id="Participant_14x55xq" name="Get yacheyka Transaction" processRef="Process_0him2gc" />
    <participant id="Participant_0w0w2c1" name="Update order status Transaction" processRef="Process_19nj9qr" />
    <participant id="Participant_0g5lzso" name="Get yacheyka Transaction" processRef="Process_1u65dt9" />
    <participant id="Participant_DistributedTx" name="Distributed Transaction (JTA/XA)" processRef="Process_DistributedTx" />

    <messageFlow id="Flow_CreateOrder" sourceRef="ClientTask_CreateOrder" targetRef="OrderStart_CreateOrder" />
    <messageFlow id="Flow_EnqueueStatusAfterCreate" sourceRef="OrderThrow_Created" targetRef="QueueCatch_Created" />
    <messageFlow id="Flow_EnqueueStatusReady" sourceRef="OrderThrow_Ready" targetRef="QueueCatch_Ready" />
    <messageFlow id="Flow_EnqueueStatusCancel" sourceRef="OrderThrow_Cancel" targetRef="QueueCatch_Cancel" />
    <messageFlow id="Flow_DeliverToNode1_Created" sourceRef="QueueThrow_ToNode1_Created" targetRef="Node1Catch_Created" />
    <messageFlow id="Flow_DeliverToNode2_Created" sourceRef="QueueThrow_ToNode2_Created" targetRef="Node2Catch_Created" />
    <messageFlow id="Flow_DeliverToNode1_Ready" sourceRef="QueueThrow_ToNode1_Ready" targetRef="Node1Catch_Ready" />
    <messageFlow id="Flow_DeliverToNode2_Ready" sourceRef="QueueThrow_ToNode2_Ready" targetRef="Node2Catch_Ready" />
    <messageFlow id="Flow_DeliverToNode1_Cancel" sourceRef="QueueThrow_ToNode1_Cancel" targetRef="Node1Catch_Cancel" />
    <messageFlow id="Flow_DeliverToNode2_Cancel" sourceRef="QueueThrow_ToNode2_Cancel" targetRef="Node2Catch_Cancel" />
    <messageFlow id="Flow_OrderReadyToEis" sourceRef="OrderThrow_EisSync" targetRef="EisCatch_Sync" />
    <messageFlow id="Flow_QuartzToOrderService" sourceRef="QuartzTask_FindExpired" targetRef="OrderCatch_ExpiredCheck" />
    <messageFlow id="Flow_Lab3_OrderCheckTx" sourceRef="OrderTask_Validate" targetRef="Activity_038bgv1" />
    <messageFlow id="Flow_Lab3_ReserveBookTx" sourceRef="OrderTask_Reserve" targetRef="Activity_1ezml6g" />
    <messageFlow id="Flow_Lab3_ReserveCountTx" sourceRef="OrderTask_Reserve" targetRef="Activity_1afbuoi" />
    <messageFlow id="Flow_Lab3_StatusTx1" sourceRef="OrderTask_StatusCreated" targetRef="Activity_0m6q70i" />
    <messageFlow id="Flow_Lab3_UpdateYacheykaTx" sourceRef="OrderTask_Delivery" targetRef="Activity_1vfenku" />
    <messageFlow id="Flow_Lab3_GetYacheykaTx1" sourceRef="OrderTask_CheckReady" targetRef="Activity_1ka0mmc" />
    <messageFlow id="Flow_Lab3_StatusTx2" sourceRef="OrderTask_StatusReady" targetRef="Activity_0wlo6fm" />
    <messageFlow id="Flow_Lab3_GetYacheykaTx2" sourceRef="OrderTask_CheckReady" targetRef="Activity_1jdgzlp" />
    <messageFlow id="Flow_Lab3_CancelCountTx" sourceRef="OrderTask_CancelExpired" targetRef="Activity_1m2h6me" />
    <messageFlow id="Flow_Lab3_ReadyDistributedTx" sourceRef="OrderTask_StatusReady" targetRef="Activity_DistributedTx" />
    <messageFlow id="Flow_Lab3_CancelDistributedTx" sourceRef="OrderTask_CancelExpired" targetRef="Activity_DistributedTx" />
  </collaboration>

  <process id="Process_Client" isExecutable="false">
    <startEvent id="ClientStart" name="Клиент хочет оформить заказ">
      <outgoing>Flow_Client_1</outgoing>
    </startEvent>
    <task id="ClientTask_CreateOrder" name="Отправить запрос на создание заказа">
      <incoming>Flow_Client_1</incoming>
      <outgoing>Flow_Client_2</outgoing>
    </task>
    <intermediateCatchEvent id="ClientCatch_Ready" name="Ожидать готовности заказа">
      <incoming>Flow_Client_2</incoming>
      <outgoing>Flow_Client_3</outgoing>
    </intermediateCatchEvent>
    <task id="ClientTask_GetOrder" name="Получить заказ в ПВЗ">
      <incoming>Flow_Client_3</incoming>
      <outgoing>Flow_Client_4</outgoing>
    </task>
    <endEvent id="ClientEnd" name="Заказ получен">
      <incoming>Flow_Client_4</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Client_1" sourceRef="ClientStart" targetRef="ClientTask_CreateOrder" />
    <sequenceFlow id="Flow_Client_2" sourceRef="ClientTask_CreateOrder" targetRef="ClientCatch_Ready" />
    <sequenceFlow id="Flow_Client_3" sourceRef="ClientCatch_Ready" targetRef="ClientTask_GetOrder" />
    <sequenceFlow id="Flow_Client_4" sourceRef="ClientTask_GetOrder" targetRef="ClientEnd" />
  </process>

  <process id="Process_OrderService" isExecutable="false">
    <startEvent id="OrderStart_CreateOrder" name="Получен REST-запрос на создание заказа">
      <messageEventDefinition messageRef="Message_OrderCreated" />
      <outgoing>Flow_Order_1</outgoing>
    </startEvent>
    <serviceTask id="OrderTask_Validate" name="Проверить заказ и пользователя">
      <incoming>Flow_Order_1</incoming>
      <outgoing>Flow_Order_2</outgoing>
    </serviceTask>
    <serviceTask id="OrderTask_Reserve" name="Зарезервировать товар и создать заказ">
      <incoming>Flow_Order_2</incoming>
      <outgoing>Flow_Order_3</outgoing>
    </serviceTask>
    <serviceTask id="OrderTask_StatusCreated" name="Установить статус CREATED / PROCESSING">
      <incoming>Flow_Order_3</incoming>
      <outgoing>Flow_Order_4</outgoing>
    </serviceTask>
    <intermediateThrowEvent id="OrderThrow_Created" name="JMS: отправить событие статуса">
      <incoming>Flow_Order_4</incoming>
      <outgoing>Flow_Order_5</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <serviceTask id="OrderTask_Delivery" name="Передать заказ в доставку / ПВЗ">
      <incoming>Flow_Order_5</incoming>
      <outgoing>Flow_Order_6</outgoing>
    </serviceTask>
    <serviceTask id="OrderTask_CheckReady" name="Асинхронно проверить заполнение ячеек">
      <incoming>Flow_Order_6</incoming>
      <outgoing>Flow_Order_7</outgoing>
    </serviceTask>
    <exclusiveGateway id="OrderGateway_Ready" name="Все позиции размещены?">
      <incoming>Flow_Order_7</incoming>
      <outgoing>Flow_Order_8_yes</outgoing>
      <outgoing>Flow_Order_8_no</outgoing>
    </exclusiveGateway>
    <serviceTask id="OrderTask_StatusReady" name="Установить статус READY_FOR_PICKUP">
      <incoming>Flow_Order_8_yes</incoming>
      <outgoing>Flow_Order_9</outgoing>
    </serviceTask>
    <intermediateThrowEvent id="OrderThrow_Ready" name="JMS: отправить READY_FOR_PICKUP">
      <incoming>Flow_Order_9</incoming>
      <outgoing>Flow_Order_10</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <serviceTask id="OrderTask_PrepareEis" name="Сформировать документ заказа">
      <incoming>Flow_Order_10</incoming>
      <outgoing>Flow_Order_11</outgoing>
    </serviceTask>
    <intermediateThrowEvent id="OrderThrow_EisSync" name="Передать документ в EIS через JCA">
      <incoming>Flow_Order_11</incoming>
      <outgoing>Flow_Order_12</outgoing>
      <messageEventDefinition messageRef="Message_EisSync" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="OrderThrow_ClientReady" name="Сообщить клиенту о готовности заказа">
      <incoming>Flow_Order_12</incoming>
      <outgoing>Flow_Order_13</outgoing>
    </intermediateThrowEvent>
    <endEvent id="OrderEnd_Success" name="Ожидание выдачи заказа">
      <incoming>Flow_Order_13</incoming>
    </endEvent>

    <intermediateCatchEvent id="OrderCatch_ExpiredCheck" name="Quartz: проверить просроченные заказы">
      <outgoing>Flow_Order_14_timer</outgoing>
    </intermediateCatchEvent>
    <serviceTask id="OrderTask_FindExpired" name="Найти заказы с истекшим сроком хранения">
      <incoming>Flow_Order_14_timer</incoming>
      <outgoing>Flow_Order_15</outgoing>
    </serviceTask>
    <exclusiveGateway id="OrderGateway_Expired" name="Есть просроченные?">
      <incoming>Flow_Order_15</incoming>
      <outgoing>Flow_Order_17_yes</outgoing>
      <outgoing>Flow_Order_17_no</outgoing>
    </exclusiveGateway>
    <serviceTask id="OrderTask_CancelExpired" name="Отменить заказ и освободить резерв">
      <incoming>Flow_Order_17_yes</incoming>
      <outgoing>Flow_Order_18</outgoing>
    </serviceTask>
    <intermediateThrowEvent id="OrderThrow_Cancel" name="JMS: отправить CANCELED">
      <incoming>Flow_Order_18</incoming>
      <outgoing>Flow_Order_19</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <endEvent id="OrderEnd_Expired" name="Просроченные заказы обработаны">
      <incoming>Flow_Order_19</incoming>
      <incoming>Flow_Order_17_no</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Order_1" sourceRef="OrderStart_CreateOrder" targetRef="OrderTask_Validate" />
    <sequenceFlow id="Flow_Order_2" sourceRef="OrderTask_Validate" targetRef="OrderTask_Reserve" />
    <sequenceFlow id="Flow_Order_3" sourceRef="OrderTask_Reserve" targetRef="OrderTask_StatusCreated" />
    <sequenceFlow id="Flow_Order_4" sourceRef="OrderTask_StatusCreated" targetRef="OrderThrow_Created" />
    <sequenceFlow id="Flow_Order_5" sourceRef="OrderThrow_Created" targetRef="OrderTask_Delivery" />
    <sequenceFlow id="Flow_Order_6" sourceRef="OrderTask_Delivery" targetRef="OrderTask_CheckReady" />
    <sequenceFlow id="Flow_Order_7" sourceRef="OrderTask_CheckReady" targetRef="OrderGateway_Ready" />
    <sequenceFlow id="Flow_Order_8_yes" sourceRef="OrderGateway_Ready" targetRef="OrderTask_StatusReady" />
    <sequenceFlow id="Flow_Order_8_no" sourceRef="OrderGateway_Ready" targetRef="OrderEnd_Success" name="Нет" />
    <sequenceFlow id="Flow_Order_9" sourceRef="OrderTask_StatusReady" targetRef="OrderThrow_Ready" />
    <sequenceFlow id="Flow_Order_10" sourceRef="OrderThrow_Ready" targetRef="OrderTask_PrepareEis" />
    <sequenceFlow id="Flow_Order_11" sourceRef="OrderTask_PrepareEis" targetRef="OrderThrow_EisSync" />
    <sequenceFlow id="Flow_Order_12" sourceRef="OrderThrow_EisSync" targetRef="OrderThrow_ClientReady" />
    <sequenceFlow id="Flow_Order_13" sourceRef="OrderThrow_ClientReady" targetRef="OrderEnd_Success" />
    <sequenceFlow id="Flow_Order_14_timer" sourceRef="OrderCatch_ExpiredCheck" targetRef="OrderTask_FindExpired" />
    <sequenceFlow id="Flow_Order_15" sourceRef="OrderTask_FindExpired" targetRef="OrderGateway_Expired" />
    <sequenceFlow id="Flow_Order_16" sourceRef="OrderGateway_Expired" targetRef="OrderTask_CancelExpired" name="Да" />
    <sequenceFlow id="Flow_Order_17_yes" sourceRef="OrderTask_CancelExpired" targetRef="OrderThrow_Cancel" />
    <sequenceFlow id="Flow_Order_17_no" sourceRef="OrderGateway_Expired" targetRef="OrderEnd_Expired" name="Нет" />
    <sequenceFlow id="Flow_Order_18" sourceRef="OrderThrow_Cancel" targetRef="OrderEnd_Expired" />
  </process>

  <process id="Process_ActiveMQ" isExecutable="false">
    <startEvent id="QueueStart" name="Очередь активна">
      <outgoing>Flow_Queue_0</outgoing>
    </startEvent>
    <parallelGateway id="QueueGateway_Split">
      <incoming>Flow_Queue_0</incoming>
      <outgoing>Flow_Queue_1</outgoing>
      <outgoing>Flow_Queue_4</outgoing>
      <outgoing>Flow_Queue_7</outgoing>
    </parallelGateway>

    <intermediateCatchEvent id="QueueCatch_Created" name="Принять CREATED/PROCESSING">
      <incoming>Flow_Queue_1</incoming>
      <outgoing>Flow_Queue_2</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <eventBasedGateway id="QueueGateway_Created" name="Конкурирующие потребители">
      <incoming>Flow_Queue_2</incoming>
      <outgoing>Flow_Queue_3a</outgoing>
      <outgoing>Flow_Queue_3b</outgoing>
    </eventBasedGateway>
    <intermediateThrowEvent id="QueueThrow_ToNode1_Created" name="Доставить на узел #1">
      <incoming>Flow_Queue_3a</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="QueueThrow_ToNode2_Created" name="Доставить на узел #2">
      <incoming>Flow_Queue_3b</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>

    <intermediateCatchEvent id="QueueCatch_Ready" name="Принять READY_FOR_PICKUP">
      <incoming>Flow_Queue_4</incoming>
      <outgoing>Flow_Queue_5</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <eventBasedGateway id="QueueGateway_Ready" name="Конкурирующие потребители">
      <incoming>Flow_Queue_5</incoming>
      <outgoing>Flow_Queue_6a</outgoing>
      <outgoing>Flow_Queue_6b</outgoing>
    </eventBasedGateway>
    <intermediateThrowEvent id="QueueThrow_ToNode1_Ready" name="Доставить на узел #1">
      <incoming>Flow_Queue_6a</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="QueueThrow_ToNode2_Ready" name="Доставить на узел #2">
      <incoming>Flow_Queue_6b</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>

    <intermediateCatchEvent id="QueueCatch_Cancel" name="Принять CANCELED">
      <incoming>Flow_Queue_7</incoming>
      <outgoing>Flow_Queue_8</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <eventBasedGateway id="QueueGateway_Cancel" name="Конкурирующие потребители">
      <incoming>Flow_Queue_8</incoming>
      <outgoing>Flow_Queue_9a</outgoing>
      <outgoing>Flow_Queue_9b</outgoing>
    </eventBasedGateway>
    <intermediateThrowEvent id="QueueThrow_ToNode1_Cancel" name="Доставить на узел #1">
      <incoming>Flow_Queue_9a</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="QueueThrow_ToNode2_Cancel" name="Доставить на узел #2">
      <incoming>Flow_Queue_9b</incoming>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateThrowEvent>

    <sequenceFlow id="Flow_Queue_0" sourceRef="QueueStart" targetRef="QueueGateway_Split" />
    <sequenceFlow id="Flow_Queue_1" sourceRef="QueueGateway_Split" targetRef="QueueCatch_Created" />
    <sequenceFlow id="Flow_Queue_2" sourceRef="QueueCatch_Created" targetRef="QueueGateway_Created" />
    <sequenceFlow id="Flow_Queue_3a" sourceRef="QueueGateway_Created" targetRef="QueueThrow_ToNode1_Created" />
    <sequenceFlow id="Flow_Queue_3b" sourceRef="QueueGateway_Created" targetRef="QueueThrow_ToNode2_Created" />
    <sequenceFlow id="Flow_Queue_4" sourceRef="QueueGateway_Split" targetRef="QueueCatch_Ready" />
    <sequenceFlow id="Flow_Queue_5" sourceRef="QueueCatch_Ready" targetRef="QueueGateway_Ready" />
    <sequenceFlow id="Flow_Queue_6a" sourceRef="QueueGateway_Ready" targetRef="QueueThrow_ToNode1_Ready" />
    <sequenceFlow id="Flow_Queue_6b" sourceRef="QueueGateway_Ready" targetRef="QueueThrow_ToNode2_Ready" />
    <sequenceFlow id="Flow_Queue_7" sourceRef="QueueGateway_Split" targetRef="QueueCatch_Cancel" />
    <sequenceFlow id="Flow_Queue_8" sourceRef="QueueCatch_Cancel" targetRef="QueueGateway_Cancel" />
    <sequenceFlow id="Flow_Queue_9a" sourceRef="QueueGateway_Cancel" targetRef="QueueThrow_ToNode1_Cancel" />
    <sequenceFlow id="Flow_Queue_9b" sourceRef="QueueGateway_Cancel" targetRef="QueueThrow_ToNode2_Cancel" />
  </process>

  <process id="Process_Node1" isExecutable="false">
    <intermediateCatchEvent id="Node1Catch_Created" name="Получить событие статуса">
      <outgoing>Flow_Node1_1</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node1Task_SaveHistoryCreated" name="Сохранить историю статуса">
      <incoming>Flow_Node1_1</incoming>
      <outgoing>Flow_Node1_2</outgoing>
    </serviceTask>
    <endEvent id="Node1End_Created">
      <incoming>Flow_Node1_2</incoming>
    </endEvent>

    <intermediateCatchEvent id="Node1Catch_Ready" name="Получить READY_FOR_PICKUP">
      <outgoing>Flow_Node1_3</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node1Task_SaveHistoryReady" name="Сохранить историю READY_FOR_PICKUP">
      <incoming>Flow_Node1_3</incoming>
      <outgoing>Flow_Node1_4</outgoing>
    </serviceTask>
    <endEvent id="Node1End_Ready">
      <incoming>Flow_Node1_4</incoming>
    </endEvent>

    <intermediateCatchEvent id="Node1Catch_Cancel" name="Получить CANCELED">
      <outgoing>Flow_Node1_5</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node1Task_SaveHistoryCancel" name="Сохранить историю CANCELED">
      <incoming>Flow_Node1_5</incoming>
      <outgoing>Flow_Node1_6</outgoing>
    </serviceTask>
    <endEvent id="Node1End_Cancel">
      <incoming>Flow_Node1_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Node1_1" sourceRef="Node1Catch_Created" targetRef="Node1Task_SaveHistoryCreated" />
    <sequenceFlow id="Flow_Node1_2" sourceRef="Node1Task_SaveHistoryCreated" targetRef="Node1End_Created" />
    <sequenceFlow id="Flow_Node1_3" sourceRef="Node1Catch_Ready" targetRef="Node1Task_SaveHistoryReady" />
    <sequenceFlow id="Flow_Node1_4" sourceRef="Node1Task_SaveHistoryReady" targetRef="Node1End_Ready" />
    <sequenceFlow id="Flow_Node1_5" sourceRef="Node1Catch_Cancel" targetRef="Node1Task_SaveHistoryCancel" />
    <sequenceFlow id="Flow_Node1_6" sourceRef="Node1Task_SaveHistoryCancel" targetRef="Node1End_Cancel" />
  </process>

  <process id="Process_Node2" isExecutable="false">
    <intermediateCatchEvent id="Node2Catch_Created" name="Получить событие статуса">
      <outgoing>Flow_Node2_1</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node2Task_NotifyCreated" name="Запустить пользовательское уведомление">
      <incoming>Flow_Node2_1</incoming>
      <outgoing>Flow_Node2_2</outgoing>
    </serviceTask>
    <endEvent id="Node2End_Created">
      <incoming>Flow_Node2_2</incoming>
    </endEvent>

    <intermediateCatchEvent id="Node2Catch_Ready" name="Получить READY_FOR_PICKUP">
      <outgoing>Flow_Node2_3</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node2Task_NotifyReady" name="Уведомить клиента о готовности">
      <incoming>Flow_Node2_3</incoming>
      <outgoing>Flow_Node2_4</outgoing>
    </serviceTask>
    <endEvent id="Node2End_Ready">
      <incoming>Flow_Node2_4</incoming>
    </endEvent>

    <intermediateCatchEvent id="Node2Catch_Cancel" name="Получить CANCELED">
      <outgoing>Flow_Node2_5</outgoing>
      <messageEventDefinition messageRef="Message_StatusChanged" />
    </intermediateCatchEvent>
    <serviceTask id="Node2Task_NotifyCancel" name="Уведомить клиента об отмене">
      <incoming>Flow_Node2_5</incoming>
      <outgoing>Flow_Node2_6</outgoing>
    </serviceTask>
    <endEvent id="Node2End_Cancel">
      <incoming>Flow_Node2_6</incoming>
    </endEvent>

    <sequenceFlow id="Flow_Node2_1" sourceRef="Node2Catch_Created" targetRef="Node2Task_NotifyCreated" />
    <sequenceFlow id="Flow_Node2_2" sourceRef="Node2Task_NotifyCreated" targetRef="Node2End_Created" />
    <sequenceFlow id="Flow_Node2_3" sourceRef="Node2Catch_Ready" targetRef="Node2Task_NotifyReady" />
    <sequenceFlow id="Flow_Node2_4" sourceRef="Node2Task_NotifyReady" targetRef="Node2End_Ready" />
    <sequenceFlow id="Flow_Node2_5" sourceRef="Node2Catch_Cancel" targetRef="Node2Task_NotifyCancel" />
    <sequenceFlow id="Flow_Node2_6" sourceRef="Node2Task_NotifyCancel" targetRef="Node2End_Cancel" />
  </process>

  <process id="Process_Quartz" isExecutable="false">
    <startEvent id="QuartzStart_Timer" name="Cron trigger Quartz">
      <timerEventDefinition />
      <outgoing>Flow_Quartz_1</outgoing>
    </startEvent>
    <serviceTask id="QuartzTask_FindExpired" name="Запустить проверку заказов по расписанию">
      <incoming>Flow_Quartz_1</incoming>
      <outgoing>Flow_Quartz_2</outgoing>
    </serviceTask>
    <endEvent id="QuartzEnd">
      <incoming>Flow_Quartz_2</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Quartz_1" sourceRef="QuartzStart_Timer" targetRef="QuartzTask_FindExpired" />
    <sequenceFlow id="Flow_Quartz_2" sourceRef="QuartzTask_FindExpired" targetRef="QuartzEnd" />
  </process>

  <process id="Process_EIS" isExecutable="false">
    <intermediateCatchEvent id="EisCatch_Sync" name="Получить документ заказа">
      <messageEventDefinition messageRef="Message_EisSync" />
      <outgoing>Flow_Eis_1</outgoing>
    </intermediateCatchEvent>
    <serviceTask id="EisTask_JcaAdapter" name="Обработать через JCA resource adapter">
      <incoming>Flow_Eis_1</incoming>
      <outgoing>Flow_Eis_2</outgoing>
